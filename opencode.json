      "du *": "allow",
      "cp artifacts/downloads/* artifacts/*": "allow",
      "cp /Users/start/Development/Blender-Kart-Simplified/artifacts/downloads/* /Users/start/Development/Blender-Kart-Simplified/artifacts/*": "allow",
