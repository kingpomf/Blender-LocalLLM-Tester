{
  "$schema": "https://opencode.ai/config.json",
  "model": "z6-llama/qwen38-27b",
  "small_model": "z6-llama/qwen38-27b",
  "enabled_providers": ["z6-llama"],
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "artifacts/archive/**",
      "artifacts/downloads/**",
      "artifacts/blend/**",
      "artifacts/exports/**",
      "artifacts/renders/**"
    ]
  },
  "mcp": {
    "unityMCP": { "enabled": false },
    "blenderMCP": { "enabled": false },
    "audioMCP": { "enabled": false },
    "appleCreatorMCP": { "enabled": false },
    "imageMCP": { "enabled": false },
    "elitedesk-blender-worker": { "enabled": false },
    "z6-blender-worker": {
      "type": "local",
      "command": [
        "uv", "--directory", "/Users/start/Development/blender-new-llm-setup",
        "run", "--frozen", "--extra", "mcp", "python", "-m", "blender_worker.mcp_server"
      ],
      "enabled": true,
      "environment": {
        "BLENDER_DOWNLOADS": "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/downloads"
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "deny",
      "ls": "allow",
      "ls *": "allow",
      "test *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "cp artifacts/downloads/* artifacts/*": "allow",
      "shasum -a 256 artifacts/*": "allow"
    },
    "z6-blender-worker_*": "allow"
  }
}
