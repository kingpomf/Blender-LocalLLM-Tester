{
  "$schema": "https://opencode.ai/config.json",
  "model": "z6-llama/qwen38-flash-next",
  "small_model": "z6-llama/qwen38-flash-next",
  "provider": {
    "z6-llama": {
      "models": {
        "qwen38-flash-next": {
          "name": "Qwen3.8 Flash-Next IQ3_S — Strata (256K)",
          "limit": {"context": 262144, "output": 32768},
          "tool_call": true,
          "reasoning": true,
          "interleaved": {"field": "reasoning_content"},
          "modalities": {"input": ["text"], "output": ["text"]}
        }
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "agent": {"build": {"model": "z6-llama/qwen38-flash-next", "tools": {"task": false}, "permission": {"task": "deny"}}},
  "experimental": {"continue_loop_on_deny": true},
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 49152
  },
  "tool_output": {"max_lines": 160, "max_bytes": 12000},
  "watcher": {
    "ignore": [
      ".git/**",
      "artifacts/archive/**",
      "artifacts/downloads/**",
      "artifacts/blend/**",
      "artifacts/exports/**",
      "artifacts/renders/**"
    ]
  },
  "mcp": {
    "unityMCP": { "enabled": false },
    "blenderMCP": { "enabled": false },
    "audioMCP": { "enabled": false },
    "appleCreatorMCP": { "enabled": false },
    "imageMCP": { "enabled": false },
    "elitedesk-blender-worker": { "enabled": false },
    "z6-blender-worker": {
      "type": "local",
      "command": [
        "uv", "--directory", "/Users/start/Development/blender-new-llm-setup",
        "run", "--frozen", "--extra", "mcp", "python", "-m", "blender_worker.mcp_server"
      ],
      "enabled": true,
      "environment": {
        "BLENDER_SSH_TARGET": "kingpomf@z6-llm",
        "BLENDER_REMOTE_APP": "/home/kingpomf/Development/blender-new-llm-setup",
        "BLENDER_REMOTE_ROOT": "/home/kingpomf/Development/blender-new-llm-setup/var/kart-simplified-flash-next-strata-20261025-r1",
        "BLENDER_REMOTE_BINARY": "/home/kingpomf/Development/blender-new-llm-setup/tools/blender-5.2.3-linux-x64/blender",
        "BLENDER_DOWNLOADS": "/Users/start/Development/Blender-Kart-Simplified/artifacts/downloads"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "*": "allow",
      "/Users/start/Development/Blender-Kart-Simplified/support/**": "deny",
      "/Users/start/Development/Blender-Kart-Simplified/spec/**": "deny",
      "/Users/start/Development/Blender-Kart-Simplified/opencode.json": "deny",
      "/Users/start/Development/Blender-Kart-Simplified/.opencode/**": "deny",
      "/Users/start/Development/Blender-Kart-Simplified/.runtime/**": "deny",
      "/Users/start/Development/Blender-Kart-Simplified/scripts/check_resume.py": "deny",
      "/Users/start/Development/Blender-Kart-Simplified/scripts/check_delivery.py": "deny",
      "/Users/start/Development/Blender-Kart-Simplified/scripts/run_kart.py": "deny"
    },
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": {
      "*": "ask",
      "/Users/start/Library/CloudStorage/OneDrive-Personal/AI-Creative/Review/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "test *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
