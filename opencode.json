{
  "$schema": "https://opencode.ai/config.json",
  "model": "z6-llama/qwen38-turbo",
  "small_model": "z6-llama/qwen38-turbo",
  "provider": {
    "z6-llama": {
      "models": {
        "qwen38-turbo": {
          "name": "Qwen3.8 Turbo (136K) — fresh Blender trial",
          "limit": {"context": 139264, "output": 16384},
          "tool_call": true,
          "reasoning": true,
          "modalities": {"input": ["text"], "output": ["text"]}
        }
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "agent": {
    "build": {"model": "z6-llama/qwen38-turbo"},
    "bowling-coder": {
      "description": "Qwen3.8 Turbo asset author using installed API guidance and enforced MCP validation/render queues",
      "mode": "primary",
      "model": "z6-llama/qwen38-turbo",
      "tools": {"bash": false, "task": false},
      "permission": {
        "bash": "deny",
        "task": "deny",
        "imageMCP_*": "deny",
        "edit": {
          "*": "allow",
          "/Users/start/Development/Blender-LocalLLM-Tester/BUILD_STATUS.md": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/HANDOFF.md": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/scripts/**": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/spec/**": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/.runtime/**": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/.opencode/**": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/opencode.json": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/scripts/validate_bowling_pair01.py": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/scripts/accepted_*.py": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/reports/validation.json": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/reports/blender-api-catalog*.json": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/reports/checkpoint.json": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/reports/render-manifest.json": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/reports/qualitative-evidence.json": "deny",
          "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/reports/DELIVERY_MANIFEST.json": "deny"
        }
      }
    }
  },
  "experimental": {"continue_loop_on_deny": true},
  "lsp": {
    "pyright": {
      "command": ["./.venv/bin/pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32768
  },
  "tool_output": {"max_lines": 160, "max_bytes": 12000},
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "artifacts/archive/**",
      "artifacts/downloads/**",
      "artifacts/blend/**",
      "artifacts/exports/**",
      "artifacts/renders/**"
    ]
  },
  "mcp": {
    "unityMCP": { "enabled": false },
    "blenderMCP": { "enabled": false },
    "audioMCP": { "enabled": false },
    "appleCreatorMCP": { "enabled": false },
    "imageMCP": {"enabled": true},
    "elitedesk-blender-worker": { "enabled": false },
    "z6-blender-worker": {"enabled": false},
    "bowling-blender52": {
      "type": "local",
      "command": [
        "/Users/start/Development/blender-new-llm-setup/.venv/bin/python",
        "/Users/start/Development/Blender-LocalLLM-Tester/scripts/blender52_mcp.py"
      ],
      "enabled": true
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": {
      "*": "ask",
      "/Users/start/Library/CloudStorage/OneDrive-Personal/AI-Creative/Review/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "test *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python artifacts/scripts/*": "allow",
      "python3 artifacts/scripts/*": "allow",
      "python3 scripts/check_resume.py": "allow",
      "python3 scripts/check_references.py": "allow",
      "python3 scripts/review_reference_images.py": "allow",
      "python3 scripts/checkpoint_bowling.py *": "allow",
      "python3 scripts/validate_checkpoint.py": "allow",
      "python3 scripts/validate_checkpoint.py *": "allow",
      "python3 scripts/validation_summary.py": "allow",
      "python3 scripts/run_bowling.py": "allow",
      "python3 scripts/run_bowling.py *": "allow",
      ".venv/bin/pyright *": "allow",
      "sips *": "allow",
      "file artifacts/*": "allow",
      "du *": "allow",
      "cp artifacts/downloads/* artifacts/*": "allow",
      "shasum -a 256 artifacts/*": "allow"
    },
    "z6-blender-worker_*": "deny",
    "bowling-blender52_*": "allow",
    "imageMCP_*": "allow",
    "doom_loop": "deny"
  }
}
