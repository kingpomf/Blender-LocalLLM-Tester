{
  "$schema": "https://opencode.ai/config.json",
  "model": "z6-llama/qwen38-flash-next",
  "small_model": "z6-llama/qwen38-flash-next",
  "provider": {
    "z6-llama": {
      "models": {
        "qwen38-flash-next": {
          "name": "Qwen3.8 Flash-Next IQ3_S — Strata (256K)",
          "limit": {"context": 262144, "output": 32768},
          "tool_call": true,
          "reasoning": true,
          "interleaved": {"field":"reasoning_content"},
          "modalities": {"input": ["text"], "output": ["text"]}
        }
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "agent": {
    "build": {"model": "z6-llama/qwen38-flash-next"},
    "bowling-coder": {
      "description": "Flash-Next bowling author with installed API guidance; EliteDesk CPU/CUDA worker",
      "mode": "primary",
      "model": "z6-llama/qwen38-flash-next",
      "tools": {"bash": false, "task": false},
      "permission": {
        "bash": "deny",
        "task": "deny",
        "imageMCP_*": "deny",
        "edit": {
          "*": "allow",
          "/Users/start/Development/Blender-Bowling-FlashNext/BUILD_STATUS.md": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/HANDOFF.md": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/scripts/**": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/spec/**": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/.runtime/**": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/.opencode/**": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/opencode.json": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/artifacts/scripts/validate_bowling_pair01.py": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/artifacts/scripts/accepted_*.py": "deny",
          "/Users/start/Development/Blender-Bowling-FlashNext/artifacts/reports/*.json": "deny"
        }
      }
    }
  },
  "experimental": {"continue_loop_on_deny": true, "mcp_timeout": 120000},
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 49152
  },
  "tool_output": {"max_lines": 160, "max_bytes": 12000},
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "artifacts/archive/**",
      "artifacts/downloads/**",
      "artifacts/blend/**",
      "artifacts/exports/**",
      "artifacts/renders/**"
    ]
  },
  "mcp": {
    "unityMCP": { "enabled": false },
    "blenderMCP": { "enabled": false },
    "audioMCP": { "enabled": false },
    "appleCreatorMCP": { "enabled": false },
    "imageMCP": {
      "type": "local",
      "command": ["/Users/start/Development/imageMCP/.venv/bin/imagemcp", "--env-file", "/Users/start/Development/imageMCP/.env"],
      "enabled": true,
      "timeout": 120000
    },
    "elitedesk-blender-worker": { "enabled": false },
    "z6-blender-worker": {"enabled": false},
    "bowling-blender52": {
      "type": "local",
      "command": [
        "/Users/start/Development/blender-new-llm-setup/.venv/bin/python",
        "/Users/start/Development/Blender-Bowling-FlashNext/scripts/blender52_mcp.py"
      ],
      "enabled": true,
      "timeout": 120000
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": {
      "*": "ask",
      "/Users/start/Library/CloudStorage/OneDrive-Personal/AI-Creative/Review/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "test *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python artifacts/scripts/*": "allow",
      "python3 artifacts/scripts/*": "allow",
      "python3 scripts/check_resume.py": "allow",
      "python3 scripts/check_references.py": "allow",
      "python3 scripts/review_reference_images.py": "allow",
      "python3 scripts/checkpoint_bowling.py *": "allow",
      "python3 scripts/validate_checkpoint.py": "allow",
      "python3 scripts/validate_checkpoint.py *": "allow",
      "python3 scripts/validation_summary.py": "allow",
      "python3 scripts/run_bowling.py": "allow",
      "python3 scripts/run_bowling.py *": "allow",
      ".venv/bin/pyright *": "allow",
      "sips *": "allow",
      "file artifacts/*": "allow",
      "du *": "allow",
      "cp artifacts/downloads/* artifacts/*": "allow",
      "shasum -a 256 artifacts/*": "allow"
    },
    "z6-blender-worker_*": "deny",
    "bowling-blender52_*": "allow",
    "imageMCP_*": "allow",
    "doom_loop": "deny"
  }
}
