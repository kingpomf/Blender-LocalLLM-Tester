{
  "$schema": "https://opencode.ai/config.json",
  "model": "z6-llama/qwen38-blender-35b",
  "small_model": "z6-llama/qwen38-blender-35b",
  "provider": {
    "z6-llama": {
      "models": {
        "qwen38-blender-35b": {
          "name": "Qwen3.8 35B A3B Blender v1 (100K)",
          "limit": {"context": 102400, "output": 16384},
          "tool_call": true,
          "reasoning": true,
          "modalities": {"input": ["text"], "output": ["text"]}
        }
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "artifacts/archive/**",
      "artifacts/downloads/**",
      "artifacts/blend/**",
      "artifacts/exports/**",
      "artifacts/renders/**"
    ]
  },
  "mcp": {
    "unityMCP": { "enabled": false },
    "blenderMCP": { "enabled": false },
    "audioMCP": { "enabled": false },
    "appleCreatorMCP": { "enabled": false },
    "imageMCP": { "enabled": false },
    "elitedesk-blender-worker": { "enabled": false },
    "z6-blender-worker": {
      "type": "local",
      "command": [
        "uv", "--directory", "/Users/start/Development/blender-new-llm-setup",
        "run", "--frozen", "--extra", "mcp", "python", "-m", "blender_worker.mcp_server"
      ],
      "enabled": true,
      "environment": {
        "BLENDER_DOWNLOADS": "/Users/start/Development/Blender-LocalLLM-Tester/artifacts/downloads"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": {
      "*": "ask",
      "/Users/start/Library/CloudStorage/OneDrive-Personal/AI-Creative/Review/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "test *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python artifacts/scripts/*": "allow",
      "python3 artifacts/scripts/*": "allow",
      "python3 scripts/check_resume.py": "allow",
      "sips *": "allow",
      "file artifacts/*": "allow",
      "du *": "allow",
      "cp artifacts/downloads/* artifacts/*": "allow",
      "shasum -a 256 artifacts/*": "allow"
    },
    "z6-blender-worker_*": "allow"
  }
}
