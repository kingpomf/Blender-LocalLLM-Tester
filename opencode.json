{
  "$schema": "https://opencode.ai/config.json",
  "model": "z6-llama/qwen36-35b-a3b-mtp-q8",
  "small_model": "z6-llama/qwen36-35b-a3b-mtp-q8",
  "provider": {
    "z6-llama": {
      "models": {
        "qwen36-35b-a3b-mtp-q8": {
          "name": "Qwen3.6 35B A3B MTP UD-Q8_K_XL (256K)",
          "limit": {"context": 262144, "output": 32768},
          "tool_call": true,
          "reasoning": true,
          "modalities": {"input": ["text"], "output": ["text"]}
        }
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "lsp": {
    "pyright": {
      "command": ["./.venv/bin/pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16384
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "artifacts/archive/**",
      "artifacts/downloads/**",
      "artifacts/blend/**",
      "artifacts/exports/**",
      "artifacts/renders/**"
    ]
  },
  "mcp": {
    "unityMCP": { "enabled": false },
    "blenderMCP": { "enabled": false },
    "audioMCP": { "enabled": false },
    "appleCreatorMCP": { "enabled": false },
    "imageMCP": {"enabled": true},
    "elitedesk-blender-worker": { "enabled": false },
    "z6-blender-worker": {"enabled": false},
    "bowling-blender52": {
      "type": "local",
      "command": [
        "/Users/start/Development/blender-new-llm-setup/.venv/bin/python",
        "/Users/start/Development/Blender-LocalLLM-Tester/scripts/blender52_mcp.py"
      ],
      "enabled": true
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": {
      "*": "ask",
      "/Users/start/Library/CloudStorage/OneDrive-Personal/AI-Creative/Review/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "test *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python artifacts/scripts/*": "allow",
      "python3 artifacts/scripts/*": "allow",
      "python3 scripts/check_resume.py": "allow",
      "python3 scripts/check_references.py": "allow",
      "python3 scripts/run_bowling.py": "allow",
      "python3 scripts/run_bowling.py *": "allow",
      ".venv/bin/pyright *": "allow",
      "sips *": "allow",
      "file artifacts/*": "allow",
      "du *": "allow",
      "cp artifacts/downloads/* artifacts/*": "allow",
      "shasum -a 256 artifacts/*": "allow"
    },
    "z6-blender-worker_*": "deny",
    "bowling-blender52_*": "allow",
    "imageMCP_*": "allow",
    "doom_loop": "deny"
  }
}
